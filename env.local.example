# Pensieve — LOCAL development environment template
#
# Copy to .env at the repo root for local native runs:
#   cp env.local.example .env
#
# This file is loaded only by pensieve-serve (`just run-serve`) and
# pensieve-preview (`just run-preview`); override its location with
# `--dotenv <path>` or DOTENV_PATH (default .env). The ingester never loads
# .env — it is configured via CLI flags (see `just run-ingest --help`).
#
# For the PRODUCTION (Docker + systemd) stack, use env.production.example instead.

# ── Logging ─────────────────────────────────────────────────────────────────
RUST_LOG=info

# ── ClickHouse (point at your own local or remote instance) ──────────────────
CLICKHOUSE_URL=http://localhost:8123
# NOTE: the binaries read CLICKHOUSE_DATABASE (not CLICKHOUSE_DB).
CLICKHOUSE_DATABASE=nostr

# ── API server (pensieve-serve) ──────────────────────────────────────────────
PENSIEVE_BIND_ADDR=127.0.0.1:8080
# Comma-separated tokens; generate with: openssl rand -hex 32
PENSIEVE_API_TOKENS=dev-token
# SQLite relay-stats DB written by the ingester; read by relay endpoints.
RELAY_DB_PATH=./data/relay-stats.db

# Optional Postgres-backed analytics families (see crates/pensieve-serve/README.md).
# DATABASE_URL is required once any family is selected; the watermark path is
# required for the `overview` family.
# PENSIEVE_POSTGRES_API_FAMILIES=
# DATABASE_URL=postgresql://pensieve_analytics@127.0.0.1:5432/pensieve
# POSTGRES_ANALYTICS_PASSWORD=
# PENSIEVE_POSTGRES_POOL_SIZE=4
# PENSIEVE_LATEST_EVENT_WATERMARK_PATH=
# PENSIEVE_LATEST_EVENT_WATERMARK_MAX_AGE_SECS=900

# ── Preview server (pensieve-preview), optional ──────────────────────────────
PREVIEW_BIND_ADDR=127.0.0.1:8081
PREVIEW_BASE_URL=http://localhost:8081
PREVIEW_SITE_NAME=Nostr Preview
# VIP pubkeys file (one hex or npub per line) whose pages get longer cache TTLs
# PREVIEW_VIP_FILE=.vip
# Compact ClickHouse lookups (migration 017): none, all, or profiles,zaps,addressable
# PREVIEW_COMPACT_LOOKUPS=none
# Rehearse without projections (optimize_use_projections=0 on every preview query)
# PREVIEW_DISABLE_PROJECTIONS=false
