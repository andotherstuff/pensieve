# Non-secret overrides for the recurring shadow analytics refresh.
# Install as /etc/pensieve/analytics-refresh.env with mode 0640.

# The first deployed checkpoint currently has a snapshot-specific filename.
# A fresh installation may instead use /archive/analytics/slice-a.duckdb.
PENSIEVE_ANALYTICS_WORK_DATABASE=/archive/analytics/slice-a.duckdb

# The job retains compact run evidence indefinitely, the newest three
# copy-on-write DuckDB backups, and the newest two verified Parquet delta caches.
PENSIEVE_ANALYTICS_RETAIN_BACKUPS=3
PENSIEVE_ANALYTICS_RETAIN_DELTAS=2

# Fail before staging or checkpoint work if /archive has less than 500 GiB
# available. Also fail the run if ingestion is not active or restarts while the
# refresh is running.
PENSIEVE_ANALYTICS_MIN_ARCHIVE_FREE_BYTES=536870912000
PENSIEVE_ANALYTICS_REQUIRE_INGEST_ACTIVE=1

# Enable only after the initial bounded identity publication has succeeded and
# its evidence is installed in the current analytics generation. Successor
# runs scan only verified delta objects, stream-merge the immutable first-seen
# state, and publish Slice A plus B1 in one Postgres transaction.
PENSIEVE_ANALYTICS_IDENTITY_ENABLED=0
PENSIEVE_ANALYTICS_IDENTITY_ROOT=/archive/analytics/pubkey-first-seen

# Enable only after the one-time Slice B2 activity canary has published and its
# immutable activity-evidence.json is installed in the current analytics
# generation. This requires the identity lane above. Successor runs scan only
# verified delta objects and publish Slice A, B1, and B2 atomically.
PENSIEVE_ANALYTICS_ACTIVITY_ENABLED=0
PENSIEVE_ANALYTICS_ACTIVITY_ROOT=/archive/analytics/fixed-activity

# Enable only after the one-time Slice B3 cohort publication has succeeded and
# cohort-evidence.json is installed in the current generation. This requires
# both bounded identity and activity lanes. Successor runs rebuild the compact
# exact matrix from their immutable successor artifacts and publish B3 in the
# same Postgres transaction.
PENSIEVE_ANALYTICS_COHORT_ENABLED=0

# Enable Slice 6 only after its initial flexible-distinct product and passed
# tolerance evidence are installed in the current generation.
PENSIEVE_ANALYTICS_FLEXIBLE_ENABLED=0
PENSIEVE_ANALYTICS_FLEXIBLE_ROOT=/archive/analytics/flexible-distinct

# Enable Slice 7 only after its initial semantic and zap-distinct evidence are
# installed in the current generation. The recurring lane advances semantic
# facts from delta objects, rebuilds bounded zap leaves, and publishes both in
# the same transaction as B3 and Slice 6.
PENSIEVE_ANALYTICS_SEMANTIC_ENABLED=0
PENSIEVE_ANALYTICS_SEMANTIC_ROOT=/archive/analytics/semantic-facts
PENSIEVE_ANALYTICS_ZAP_DISTINCT_ROOT=/archive/analytics/zap-distinct

# Bounded staging ceilings applied before object-store access.
MAX_STAGE_OBJECTS=1000
MAX_STAGE_BYTES=107374182400
STAGE_TRANSFERS=4
STAGE_CHECKERS=8

# Production uses an S3-compatible endpoint requiring path-style addressing.
PENSIEVE_ANALYTICS_S3_FORCE_PATH_STYLE=1
