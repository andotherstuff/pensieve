# Source notepack archive. Configure this remote in RCLONE_CONFIG.
SOURCE_REMOTE=storagebox:pensieve/archive
RCLONE_CONFIG=/etc/pensieve/rclone.conf

# Durable worker paths.
STATE_DB=/var/lib/pensieve-parquet/state/campaign.sqlite
STAGING_DIR=/var/lib/pensieve-parquet/staging/campaign
INPUT_DIR=/var/lib/pensieve-parquet/input
RECEIPT_DIR=/var/lib/pensieve-parquet/state/receipts
LOCK_FILE=/var/lib/pensieve-parquet/state/campaign.lock
CAMPAIGN_BIN=/srv/pensieve/repo/target/release/pensieve-parquet-campaign

# Preserve 5 GiB after reserving three times the compressed source bytes for
# the current input, generated Parquet, and temporary files.
MIN_FREE_BYTES=5368709120
WORKING_SPACE_MULTIPLIER=3

# Zero processes the entire remote inventory. Use 1 for a production canary.
MAX_WORK_UNITS=0

# Set to 1 for a read-only source selection audit without downloading or
# publishing any segment.
INVENTORY_ONLY=0

# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION, S3_BUCKET,
# S3_ENDPOINT_URL, and S3_ARCHIVE_PREFIX come from the separate restricted
# object-storage EnvironmentFile.
