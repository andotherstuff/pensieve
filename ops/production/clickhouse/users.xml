<?xml version="1.0"?>
<!--
    ClickHouse users configuration for Pensieve

    This file is mounted to /etc/clickhouse-server/users.d/custom.xml
    It adds a read-only 'grafana' user for dashboard queries.

    Settings profiles must be defined here (or elsewhere under users.d), not
    in config.xml: ClickHouse ignores <profiles> in server config.d files.
    The `default` profile is intentionally left at stock settings.

    Changes reach a running server only if the container sees the new file.
    This is a single-file bind mount, resolved to an inode each time the
    container starts. `git merge` replaces the file (new inode), so a running
    container keeps the old content until it is restarted or recreated
    (`docker restart`, a Docker daemon restart and a reboot all count).
    For the in-place rollout, see "Published ports and the grafana ClickHouse
    user" in ops/RUNBOOK.md.
-->
<clickhouse>
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- Users -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <users>
        <!--
            Grafana user - read-only access to the nostr database for dashboards
            Password is set via environment variable CLICKHOUSE_GRAFANA_PASSWORD
        -->
        <grafana>
            <!-- Plaintext password read from env var CLICKHOUSE_GRAFANA_PASSWORD (not hashed) -->
            <password from_env="CLICKHOUSE_GRAFANA_PASSWORD"/>

            <!--
                Network access - any address (::/0). Exposure is limited by
                compose.yml, which publishes 8123/9000 on 127.0.0.1 only;
                containers on the Docker network can also connect.
            -->
            <networks>
                <ip>::/0</ip>
            </networks>

            <!-- Use the readonly profile -->
            <profile>readonly</profile>

            <!-- Default quota (unlimited) -->
            <quota>default</quota>

            <!-- No SQL user/grant management for this user. -->
            <access_management>0</access_management>

            <!--
                Privileges. Without <grants> (or <allow_databases>) a users.xml
                user gets GRANT ALL ON *.*, so readonly alone let this user read
                every database. <grants> is used rather than <allow_databases>:
                allow_databases keeps every global privilege (url/remote/file/s3
                sources, SYSTEM, KILL QUERY) and cannot name single system tables.

                - SELECT ON nostr.*: dashboard data. Implies SHOW DATABASES,
                  SHOW TABLES and SHOW COLUMNS on nostr, which the Grafana
                  ClickHouse plugin's query builder needs.
                - SELECT ON system.parts: the storage-size panel. Rows are
                  filtered to tables this user can see, i.e. nostr only.

                Everything else in `system` is refused (the stock config.xml sets
                select_from_system_db_requires_grant=true), except the tables
                ClickHouse always allows: one, functions, formats, settings,
                databases/tables/columns (filtered to nostr) and similar.
                system.query_log, processes, users and grants are refused.
            -->
            <grants>
                <query>GRANT SELECT ON nostr.*</query>
                <query>GRANT SELECT ON system.parts</query>
            </grants>
        </grafana>
    </users>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- Profiles -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <profiles>
        <!-- Read-only profile for Grafana -->
        <readonly>
            <!--
                readonly=1, not 2. Both refuse writes and DDL; 2 also lets the
                client change any setting and create temporary tables. Temporary
                tables are what url()/remote()/file() need, so readonly=2 would
                let this user run remote('127.0.0.1', ..., 'default', '') and
                read everything as `default` (no password in this compose
                setup), and would let it change max_memory_usage and
                max_rows_to_read. With readonly=1 those two are fixed; the one
                setting the Grafana plugin sends, max_execution_time, may be
                changed only within the bounds in <constraints> below.
            -->
            <readonly>1</readonly>

            <!-- Limit query resources to prevent dashboard queries from impacting ingestion -->
            <max_memory_usage>10000000000</max_memory_usage> <!-- 10 GB max per query -->
            <max_execution_time>60</max_execution_time> <!-- default; the client may set 1-300 (below) -->
            <max_rows_to_read>1000000000</max_rows_to_read> <!-- 1B rows max -->

            <!--
                Settings the client may change despite readonly=1. The Grafana
                ClickHouse plugin (clickhouse-go) sends max_execution_time from
                the datasource's query timeout (64 with the default 60 s
                timeout), so it cannot be fixed at 60. It is bounded instead:
                0 (unlimited) and anything above 300 s are refused. If a panel
                fails with "Cannot modify 'X' setting in readonly mode", add X
                here with bounds; do not switch to readonly=2.
            -->
            <constraints>
                <max_execution_time>
                    <changeable_in_readonly>1</changeable_in_readonly>
                    <min>1</min>
                    <max>300</max>
                </max_execution_time>
            </constraints>
        </readonly>
    </profiles>
</clickhouse>
