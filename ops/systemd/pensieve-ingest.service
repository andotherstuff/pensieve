[Unit]
Description=Pensieve Nostr Ingester
Documentation=https://github.com/andotherstuff/pensieve
After=network.target docker.service tor.service
Wants=docker.service tor.service

[Service]
Type=simple
User=pensieve
Group=pensieve
WorkingDirectory=/home/pensieve/pensieve
EnvironmentFile=-/etc/pensieve/parquet-shadow.env
StateDirectory=pensieve
StateDirectoryMode=0750

# Binary location (after cargo build --release)
# Tor proxy enabled by default - .onion relays route through Tor, clearnet connects directly
# Remove --tor-proxy if you don't want Tor support (or don't have tor installed)
#
# Negentropy sync (NIP-77) enabled - periodically reconciles with trusted relays
# to discover events missed during normal streaming
#
# Add --verbose-ops to ExecStart when you want periodic throughput/checkpoint
# progress at INFO without raising RUST_LOG for everything else.
ExecStart=/home/pensieve/pensieve/target/release/pensieve-ingest \
    --seed-file /home/pensieve/pensieve/data/relays/seed.txt \
    --import-discovered-json /home/pensieve/pensieve/data/relays/relay_discovery_results.json \
    --output-dir /archive/segments \
    --rocksdb-path /data/rocksdb \
    --relay-db-path /data/relay-stats.db \
    --clickhouse-url http://localhost:8123 \
    --metrics-port 9091 \
    --tor-proxy 127.0.0.1:9050 \
    --negentropy \
    --negentropy-db-path /data/sync-state \
    --negentropy-relays-file /home/pensieve/pensieve/data/relays/negentropy.txt \
    --negentropy-interval-secs 1800 \
    --negentropy-lookback-days 14

# Restart policy
Restart=always
RestartSec=10

# Stop budget: archive shutdown (final seal, compression, RocksDB flush) runs
# first, then the ClickHouse indexer gets up to 20 s to drain plus 60 s to
# reach a batch boundary. systemd's 90 s default can kill the process before
# that clean stop (2026-10-12). A kill is still safe, because the batch was
# journaled before it was sent, but a clean stop avoids the existence check
# on restart.
TimeoutStopSec=5min

# Open-file limit: the ingester holds many concurrent relay sockets; the systemd
# default caused "Too many open files" (notably during shutdown).
LimitNOFILE=524288

# Logging: the binary defaults to info with noisy upstream crates suppressed.
# To override:  systemctl edit pensieve-ingest  →  Environment=RUST_LOG=debug
# Environment=RUST_LOG=info

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pensieve-ingest

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
# Allow writes to data directories (includes negentropy sync-state in /data)
# Optional while isolated reconciliation is disabled; tmpfiles must provision
# the socket directory before explicitly enabling isolated mode.
ReadWritePaths=/data /archive /var/lib/pensieve -/run/pensieve

[Install]
WantedBy=multi-user.target
