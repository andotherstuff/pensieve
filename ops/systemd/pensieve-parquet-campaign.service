[Unit]
Description=Pensieve bounded-disk notepack to Parquet archive campaign
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/pensieve/parquet-object-storage.env
ConditionPathExists=/etc/pensieve/parquet-campaign.env
StartLimitIntervalSec=30min
StartLimitBurst=5

[Service]
Type=simple
User=pensieve
Group=pensieve
WorkingDirectory=/home/pensieve/pensieve
EnvironmentFile=/etc/pensieve/parquet-object-storage.env
EnvironmentFile=/etc/pensieve/parquet-campaign.env
ExecStart=/home/pensieve/pensieve/ops/scripts/run-parquet-archive-campaign.sh
Restart=on-failure
RestartSec=30s
TimeoutStopSec=5min
KillMode=control-group
UMask=0027
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/pensieve-parquet
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
