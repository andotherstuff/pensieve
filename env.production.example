# Pensieve — PRODUCTION environment template
#
# Production secrets live OUTSIDE the repo at /etc/pensieve/pensieve.env.
# Copy this template there and edit (mode 600, owned by the pensieve user):
#   sudo install -D -m 600 -o pensieve -g pensieve env.production.example /etc/pensieve/pensieve.env
#   sudo -u pensieve nano /etc/pensieve/pensieve.env
#
# Read from there by the Docker stack (pensieve.service: compose --env-file),
# pensieve-api, pensieve-preview, archive-sync and pensieve-analytics-refresh
# (systemd EnvironmentFile). pensieve-ingest does NOT read it: the ingester is
# configured by the flags in its unit/drop-ins and the optional
# /etc/pensieve/parquet-shadow.env (ops/parquet-shadow.env.example).
#
# For LOCAL native development, use env.local.example instead.

# ═══════════════════════════════════════════════════════════════════════════
# Domains / Reverse Proxy
# ═══════════════════════════════════════════════════════════════════════════
# For production, use your domains (Caddy auto-provisions HTTPS for both).
DOMAIN=api.example.com
# Preview domain (separate domain for public Nostr event preview pages)
PREVIEW_DOMAIN=preview.example.com

# ═══════════════════════════════════════════════════════════════════════════
# ClickHouse
# ═══════════════════════════════════════════════════════════════════════════
CLICKHOUSE_URL=http://localhost:8123
# The Pensieve binaries read CLICKHOUSE_DATABASE. (The ClickHouse container's
# own init database name is hardcoded in ops/production/compose.yml.)
CLICKHOUSE_DATABASE=nostr

# Password for the read-only 'grafana' user (used by Grafana dashboards)
# Generate a secure password: openssl rand -base64 24
CLICKHOUSE_GRAFANA_PASSWORD=changeme

# ═══════════════════════════════════════════════════════════════════════════
# API Server (pensieve-serve)
# ═══════════════════════════════════════════════════════════════════════════
PENSIEVE_BIND_ADDR=0.0.0.0:8080
# API tokens (comma-separated). Each user/client should have their own token.
# Generate tokens with: openssl rand -hex 32
PENSIEVE_API_TOKENS=your-secret-token-here
# Ingester's relay-stats SQLite; enables /api/v1/relays*. Unset, or pointing at
# a missing file, makes those endpoints return 500.
# RELAY_DB_PATH=/data/relay-stats.db
# Postgres-backed route families and their settings are documented in
# crates/pensieve-serve/README.md (production sets them in a systemd drop-in).

# ═══════════════════════════════════════════════════════════════════════════
# Preview Server (pensieve-preview)
# ═══════════════════════════════════════════════════════════════════════════
PREVIEW_BIND_ADDR=0.0.0.0:8081
# Base URL for canonical links and OG tags (no trailing slash)
PREVIEW_BASE_URL=https://preview.example.com
PREVIEW_SITE_NAME=Nostr Preview
# Path to VIP pubkeys file — one pubkey per line, hex or npub (optional).
# See ops/production/.vip.example for format.
# PREVIEW_VIP_FILE=/home/pensieve/pensieve/.vip
# Which preview lookups read the compact ClickHouse tables (migration 017)
# instead of events_local: none (default), all, or a comma list of
# profiles,zaps,addressable. Reversible with a restart. See
# docs/preview_compact_lookups.md before enabling.
# PREVIEW_COMPACT_LOOKUPS=none
# Rehearse running without the events_by_kind projection: every preview query
# runs with optimize_use_projections=0 and a 10 s cap. Use only after
# PREVIEW_COMPACT_LOOKUPS=all is validated (see ops/RUNBOOK.md).
# PREVIEW_DISABLE_PROJECTIONS=false

# ═══════════════════════════════════════════════════════════════════════════
# Postgres analytics (docker compose service postgres-analytics)
# ═══════════════════════════════════════════════════════════════════════════
# Required by compose.yml for EVERY docker compose command, even though the
# service is in the manual-postgres profile; without it pensieve.service fails.
POSTGRES_ANALYTICS_PASSWORD=changeme

# ═══════════════════════════════════════════════════════════════════════════
# Storage Box (ops/scripts/sync-archive.sh)
# ═══════════════════════════════════════════════════════════════════════════
# The ingester takes its paths and segment size as flags in its systemd unit;
# ARCHIVE_PATH here is read only by sync-archive.sh.
ARCHIVE_PATH=/archive/segments
# The script uploads to the rclone remote named "storagebox" (configured in the
# pensieve user's rclone config); STORAGE_BOX_HOST/USER are not read by it.
STORAGE_BOX_PATH=pensieve/archive
# How many days to keep segments locally before allowing deletion
LOCAL_RETENTION_DAYS=90
# Disk usage threshold (%) to trigger cleanup of old local segments
DISK_CLEANUP_THRESHOLD=80
# Report what retention would delete without deleting (default false)
# RETENTION_DRY_RUN=true

# ═══════════════════════════════════════════════════════════════════════════
# Monitoring
# ═══════════════════════════════════════════════════════════════════════════
# Grafana admin password, applied when the Grafana volume is first created.
# If unset, compose defaults it to "admin" and Caddy serves Grafana publicly.
GRAFANA_PASSWORD=changeme

# ═══════════════════════════════════════════════════════════════════════════
# Backfill (for S3 source, optional)
# ═══════════════════════════════════════════════════════════════════════════
# backfill-proto reads AWS credentials from the standard AWS chain, but takes
# the bucket and prefix only as --s3-bucket/--s3-prefix flags. Values set here
# are also visible to pensieve-analytics-refresh, whose scripts fall back to
# S3_BUCKET for the Parquet bucket, so prefer exporting them for the backfill.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
